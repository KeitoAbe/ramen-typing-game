{
  "name": "ramen-typing-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "depcruise": "depcruise src scripts --config .dependency-cruiser.cjs",
    "knip": "knip",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm depcruise && pnpm knip",
    "loop": "tsx scripts/loop/cli.ts run",
    "loop:once": "tsx scripts/loop/cli.ts once",
    "loop:state": "tsx scripts/loop/cli.ts state",
    "loop:decide": "tsx scripts/loop/cli.ts decide",
    "prepare": "simple-git-hooks",
    "loop:apply": "tsx scripts/loop/cli.ts apply"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/turbopack": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.6.0",
    "jest": "^30.5.2",
    "knip": "^6.41.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.32.1",
  "simple-git-hooks": {
    "pre-commit": "pnpm exec biome check --staged --no-errors-on-unmatched",
    "pre-push": "pnpm verify"
  },
  "engines": {
    "node": ">=24"
  }
}
